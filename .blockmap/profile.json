{
  "roots": ["src", "server/src"],
  "ext": "\\.(ts|tsx)$",
  "skipDirs": ["node_modules", "dist", "__tests__", "test"],
  "paths": { "@/*": ["src/*"] },
  "allowJs": false,
  "neutral": ["^src/components/ui/", "^src/types/", "^src/main\\.tsx$", "^src/engine/pdf/types\\.ts$", "^src/engine/tokenizer/dictionaryReplacer\\.ts$", "^src/engine/audio/mime\\.ts$"],
  "layers": [
    { "match": "^server/|^src/infra/|^src/engine/(providers|proxy)|^src/engine/pdf/(recognizers|pdfjsDoc|pdfjsPages|geminiPages)\\.ts|^src/engine/parsers/pdfSidecar\\.ts", "layer": "Infra" },
    { "match": "^src/(components|App|main)", "layer": "UI" },
    { "match": "^src/store", "layer": "State" },
    { "match": "^src/storage", "layer": "Data" },
    { "match": "^src/engine", "layer": "Domain" }
  ]
}
