    },
    {
      "from": "b2_pdf",
      "to": "b4_chapters",
      "label": "Построение плана глав из Outline / эвристик",
      "data": "PagedOutlineItem[], ChapterSpec[]"
    },
    {
      "from": "b2_pdf",
      "to": "b9_storage",
      "label": "Запись распознанных страниц и исходного PDF",
      "data": "PdfPageRecord -> db.pdfPages, db.pdfFiles"
    },
    {
      "from": "b4_chapters",
      "to": "b5_reader",
      "label": "Главы и оглавление для отображения",
      "data": "Chapter[], SentenceItem[]"
    },
    {
      "from": "b3_editor",
      "to": "b4_chapters",
      "label": "Обновление границ глав после правок",
      "data": "replaceBookChapters"
    },
    {
      "from": "b3_editor",
      "to": "b9_storage",
      "label": "Инвалидация устаревшего аудиокэша и сохранение текста",
      "data": "db.transaction(books, audioCache)"
    },
    {
      "from": "b5_reader",
      "to": "b6_tts",
      "label": "Команда на озвучку выбранного предложения",
      "data": "jumpToSentence(sentenceId)"
    },
    {
      "from": "b6_tts",
      "to": "b5_reader",
      "label": "Подсветка активного предложения и караоке",
      "data": "currentSentenceId, autoscroll"
    },
    {
      "from": "b6_tts",
      "to": "b9_storage",
      "label": "Чтение / запись Blob аудиофрагментов",
      "data": "db.audioCache"
    },
    {
      "from": "b7_billing",
      "to": "b6_tts",
      "label": "Проверка баланса перед платным TTS",
      "data": "user.balance, master keys"
    },
    {
      "from": "b8_settings",
      "to": "b6_tts",
      "label": "Провайдер, голос, API-ключи, словарь замен",
