PORT=4000
# production отключает /confirm-mock и создание платежей без ключей ЮKassa
NODE_ENV=development
# Каталог данных (по умолчанию server/data)
# DATA_DIR=./data

# PostgreSQL база данных (если указан, данные хранятся в PostgreSQL вместо локальных json)
# DATABASE_URL=postgres://postgres:password@localhost:5432/aibookreader
DATABASE_URL=

# Google Gemini (ключ передаётся заголовком x-goog-api-key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_OCR_MODEL=gemini-2.5-flash
# Стоимость одного OCR-запроса /api/pdf/parse-gemini в символах баланса
PDF_GEMINI_COST_CHARS=10000

# OpenAI TTS
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1

# ElevenLabs
ELEVENLABS_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Edge-TTS (Microsoft Neural, не требует ключа)
EDGE_TTS_ENABLED=true

# ЮKassa. Пустые ключи = dev-симуляция (только вне production)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Разрешённые origin'ы (через запятую)
ALLOWED_RETURN_ORIGINS=http://localhost:3000,http://localhost:5173,tauri://localhost,http://tauri.localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,tauri://localhost,http://tauri.localhost

# Бесплатные символы при регистрации и лимит регистраций/час/IP
FREE_CHARACTERS=15000
REGISTER_LIMIT_PER_HOUR=5
# Доверенные прокси для определения клиентского IP (Rate Limit):
# false / 0 — отключено
# true — доверие частным адресам Docker ('loopback, linklocal, uniquelocal')
# число >= 1 — количество прыжков прокси (например, 2 для Traefik -> nginx -> Node)
# подсети / имена — строка для Express (например, 'loopback, linklocal, uniquelocal' или '172.16.0.0/12')
TRUST_PROXY=false

# Локальный Python-парсер PDF (по умолчанию выключен)
ENABLE_PYTHON_PDF=false
PYTHON_PATH=
PYTHON_SCRIPT=
