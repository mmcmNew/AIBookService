# ВНИМАНИЕ: Секреты (API-ключи, пароли БД, ключи ЮKassa) никогда не должны иметь префикс VITE_!
# Переменные с префиксом VITE_ вшиваются в клиентскую сборку сайта и становятся публичными.
# Для удобства разработки и подстановки ключей в интерфейс создайте локальный файл .env.local
# и задайте в нем переменные вида VITE_*_API_KEY (он добавлен в .gitignore и не попадет в прод).

# База данных PostgreSQL (если не задана, сервер сохраняет данные в локальные JSON-файлы)
DATABASE_URL=

# Ключи провайдеров озвучки и OCR (читаются только сервером)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_OCR_MODEL=gemini-2.5-flash
EDGE_TTS_ENABLED=true

# Проксирование и сетевые лимиты
# true / loopback,linklocal,uniquelocal / количество хопов прокси (например 2)
TRUST_PROXY=loopback,linklocal,uniquelocal
CORS_ORIGINS=https://books.ndomen.ru,http://localhost:5173,http://localhost:3000,tauri://localhost,http://tauri.localhost

# Платежи ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
ALLOWED_RETURN_ORIGINS=https://books.ndomen.ru

# Бизнес-параметры и лимиты
FREE_CHARACTERS=15000
REGISTER_LIMIT_PER_HOUR=5
PDF_GEMINI_COST_CHARS=10000
